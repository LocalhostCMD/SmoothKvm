#!/bin/sh
set -e
# On upgrade keep the service settings (which account it runs as); remove them only when the app is removed.
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
  rm -rf /etc/systemd/system/smoothkvm.service.d 2>/dev/null || true
  rm -rf /var/lib/smoothkvm /run/smoothkvm-helper 2>/dev/null || true
fi
if [ -d /run/systemd/system ]; then systemctl daemon-reload || true; fi
exit 0
