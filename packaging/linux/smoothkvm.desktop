[Desktop Entry]
Type=Application
Name=SmoothKvm
GenericName=Keyboard and mouse sharing
Comment=One keyboard and mouse across all your computers
Exec=SmoothKvm app
Icon=smoothkvm
# lets SmoothKvm ask KWin for pictures of app windows (to show an app on another computer)
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
Terminal=false
Categories=Utility;Network;
Keywords=kvm;keyboard;mouse;share;pair;
