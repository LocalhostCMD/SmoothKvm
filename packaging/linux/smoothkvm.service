[Unit]
Description=SmoothKvm receiver (shares another computer's keyboard and mouse with this one)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The user is filled in by the package (see /etc/systemd/system/smoothkvm.service.d/user.conf).
ExecStart=/usr/bin/SmoothKvm service
Restart=always
RestartSec=2

# Hardening: the service only needs the network, its own config folder and /dev/uinput.
NoNewPrivileges=yes
PrivateDevices=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
